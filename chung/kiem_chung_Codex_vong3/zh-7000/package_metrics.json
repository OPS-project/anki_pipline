      "css": ".card {\n  font-family: \"Segoe UI\", \"Microsoft YaHei\", sans-serif;\n  text-align: center;\n  color: #2c3e50;\n  background-color: #fdf6e3; /* Màu kem dịu mắt */\n  padding: 20px;\n}\n\n/* --- TÙY CHỈNH Ô GÕ CHỮ (PHẦN BẠN CẦN) --- */\n#typeans { \n  font-size: 24px !important; \n  border-radius: 12px; \n  border: 2px solid #aed581; \n  padding: 12px; \n  text-align: center !important; \n  background: white;\n  width: 90%;\n  margin: 10px auto;\n}\n\n/* Nếu gõ ĐÚNG: Không hiện nền màu xanh, chỉ hiện chữ bình thường */\n.typeGood { \n  background-color: transparent !important; \n  color: #2e7d32 !important; /* Chữ màu xanh lá đậm cho dịu */\n  padding: 0 !important;\n}\n\n/* Nếu gõ SAI: Giữ nền đỏ và hiệu ứng rung */\n.typeBad { \n  background-color: #ff8a80 !important; \n  color: white !important; \n  border-radius: 4px;\n  padding: 2px 5px !important;\n  animation: shake 0.3s;\n  display: inline-block;\n}\n\n/* Nếu gõ THIẾU ký tự: Hiện nền xám nhẹ */\n.typeMissed { \n  background-color: #dfe6e9 !important; \n  color: #636e72 !important; \n}\n\n/* Hiệu ứng rung khi gõ sai */\n@keyframes shake {\n  0% { transform: translateX(0); }\n  25% { transform: translateX(-5px); }\n  50% { transform: translateX(5px); }\n  75% { transform: translateX(-5px); }\n  100% { transform: translateX(0); }\n}\n\n/* --- CÁC PHẦN BIỂU TƯỢNG VÀ TRÌNH BÀY --- */\n.section { display: flex; flex-direction: column; align-items: center; margin-bottom: 20px; }\n.symbol { font-size: 28px; margin-bottom: 5px; }\n.hanzi { font-size: 35px; font-weight:; color: #1a1a1a; line-height: 1.4; }\n.pinyin { font-size: 24px; color: #546e7a; margin-top: 5px; }\n.meaning { font-size: 24px; color: #2e7d32; font-weight: bold; margin-top: 5px; }\n.vietnamese-hint { font-size: 22px; color: #34495e; font-style: italic; margin-bottom: 10px; }\n\n.front-hanzi-hint { font-size: 35px !important; font-weight: bold; margin-top: 10px; }\n.front-hanzi-hint a.hint { font-size: 15px; color: #16a085 !important; text-decoration: none; font-weight: bold; }\n\n.btn-search { color: white; border: none; padding: 10px 22px; border-radius: 20px; cursor: pointer; font-weight: bold; }\n.note-box { background: white; padding: 15px; border-radius: 15px; border: 2px solid #e8f5e9; margin-top: 25px; text-align: left; }\n.note-title { color: #2e7d32; font-weight: bold; margin-bottom: 5px; font-size: 15px; border-bottom: 1px solid #eee; }",
