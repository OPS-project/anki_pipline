          "name": "Thẻ 1",
          "ord": 0,
          "qfmt": "\n<div class=\"card-container\">\n  <div class=\"audio-main\">{{Audio Chinese}}</div>\n  <div style=\"font-size: 50px; margin-bottom: 10px;\">🔊</div>\n\n  <div class=\"vietnamese-hint\">\n    🇻🇳 {{Phrase Vietnamese}}\n  </div>\n\n  <div style=\"margin: 20px 0;\">\n    <p style=\"font-size: 14px; color: #e67e22; font-weight: bold; margin-bottom: 8px;\">⌨️ GÕ LẠI TIẾNG TRUNG VÀO ĐÂY:</p>\n    {{type:Answer}}\n  </div>\n\n  <div class=\"hint-container\">\n    <div class=\"front-hanzi-hint\">\n      {{hint:Hanzi}}\n    </div>\n    <p style=\"font-size: 11px; color: #95a5a6; margin-top: 8px;\">(Nhấn xem nếu quên mặt chữ 👆)</p>\n  </div>\n</div>\n\n\n\n",
          "afmt": "<div class=\"card-container\">\n  <div id=\"type-answer-zone\" style=\"margin-bottom: 20px;\">\n    {{type:Answer}}\n  </div>\n\n  <hr id=\"answer\" style=\"border: 0; border-top: 2px solid #aed581; margin: 25px 0;\">\n\n  <div class=\"section\">\n    <span class=\"symbol\">🌺</span>\n    <div class=\"hanzi\">{{Hanzi}}</div>\n  </div>\n\n  <div class=\"section\">\n    <span class=\"symbol\">🍃</span>\n    <div class=\"pinyin\">{{Phrase Chinese}}</div>\n  </div>\n\n  <!-- BỔ SUNG MỤC SỐ 4: Part of Speech (Cỡ chữ ngang Pinyin, bỏ chữ Từ loại) -->\n  {{#Part of Speech}}\n  <div class=\"section\" style=\"font-style: italic; color: #616161;\">\n    <span class=\"symbol\">🏷️</span>\n    <div class=\"pinyin\" style=\"font-family: inherit;\">{{Part of Speech}}</div>\n  </div>\n  {{/Part of Speech}}\n\n  <div class=\"section\">\n    <span class=\"symbol\">🌻</span>\n    <div class=\"meaning\">{{Mean}}</div>\n  </div>\n\n  <div class=\"tool-box\" style=\"margin-top: 20px;\">\n    <p style=\"font-size: 14px; font-weight: bold; color: #388e3c; margin-bottom: 10px;\">🦜 TRA TỪ NHANH:</p>\n    <button onclick=\"search('hanzii')\" class=\"btn-search\" style=\"background: #ef6c00;\">📙 Hanzii</button>\n    <button onclick=\"search('google')\" class=\"btn-search\" style=\"background: #1976d2;\">🌍 Google</button>\n  </div>\n\n  <script>\n    (function() {\n      var isWrong = document.querySelector(\".typeBad, .typeMissed\");\n      var isCorrect = document.querySelector(\".typeGood\") && !isWrong;\n\n      var audio = new Audio();\n      if (isWrong) {\n        audio.src = \"wrong.mp3\"; \n        audio.play();\n      } else if (isCorrect) {\n        audio.src = \"correct.mp3\";\n        audio.play();\n      }\n    })();\n\n    function search(engine) {\n      var text = window.getSelection().toString().trim();\n      if (!text) { alert(\"Hãy bôi đen từ cần tra nhé! 🦜\"); return; }\n      var url = (engine === 'hanzii') \n        ? \"https://hanzii.net\" + encodeURIComponent(text)\n        : \"https://google.com\" + encodeURIComponent(text);\n      window.open(url, \"_blank\");\n    }\n  </script>\n\n  {{#Vocab}}\n  <div class=\"note-box\">\n    <div class=\"note-title\">📑 PHÂN TÍCH TỪ VỰNG:</div>\n    <div style=\"font-size: 18px;\">{{Vocab}}</div>\n    <div style=\"text-align: right; margin-top: 10px;\">🌴🍀</div>\n  </div>\n  {{/Vocab}}\n</div>\n",
          "bqfmt": "{{Hanzi}}",
