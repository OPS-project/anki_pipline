      "css": ":root {\n  --window-bg: white;\n  --text-fg: black;\n  --text-definition: #00589e;\n  --text-transcription: #002b36;\n  --text-extra: #586e75;\n}\n\n.nightMode {\n  --window-bg: #272727;\n  --text-fg: #ddd;\n  --text-definition: #81c784;\n  --text-transcription: #bdbdbd;\n  --text-extra: #9e9e9e;\n}\n\n.card {\n  font-family: arial;\n  font-size: 20px;\n  text-align: center;\n  background-color: var(--window-bg);\n  color: var(--text-fg);\n}\n\n.exa {\n  line-height: 1.5;\n}\n\n.exa .cloze {\n  color: transparent;\n  box-shadow: inset 0 -2px 0 var(--text-fg);\n}\n\n.def .cloze {\n  color: transparent;\n  box-shadow: inset 0 -2px 0 var(--text-definition);\n}\n\n.def {\n  color: var(--text-definition);\n  margin: 12px 0;\n}\n\n.word {\n  font-weight: bold;\n  font-size: 115%;\n}\n\n.transcription {\n  font-family: 'Lato', calibri, sans-serif;\n  font-size: 22px;\n  margin-top: 9px;\n  margin-bottom: 7px;\n  color: var(--text-transcription);\n}\n\n.extra {\n  margin-bottom: 11px;\n  color: var(--text-extra);\n}\n\n@font-face {\n  font-family: 'Lato';\n  font-style: normal;\n  font-weight: 400;\n  src: local(''),\n       url('_Lato-Regular.woff2') format('woff2'), /* Super Modern Browsers */\n       url('_Lato-Regular.woff') format('woff'), /* Modern Browsers */\n       url('_Lato-Regular.ttf') format('truetype'); /* Safari, Android, iOS */\n}\n",
